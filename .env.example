# Copy this file to .env and fill in your values
# Get your App ID from: https://instantdb.com/dash

VITE_INSTANT_APP_ID=your-instantdb-app-id-here

# Required for Backend API / Webhooks
INSTANT_ADMIN_TOKEN=your-admin-token-here

# Postgres migration feature flags (dev .env only — never set in prod)
# USE_PG_AUTH=true  → login/auth uses Postgres JWT instead of InstantDB
# USE_PG_DATA=true  → server API endpoints read from Postgres instead of InstantDB
USE_PG_AUTH=
USE_PG_DATA=

# PostgreSQL — APP role connection string (RLS enforced, not the owner string)
# Get from /root/pg_credentials.txt on the VPS (the APP line, not OWNER)
# Dev:  postgresql://t2gcrm_dev_app:<pass>@localhost:5432/t2gcrm_dev
# Prod: postgresql://t2gcrm_prod_app:<pass>@localhost:5432/t2gcrm_prod
DATABASE_URL=

# JWT — sign with a long random secret (generate with: openssl rand -hex 32)
JWT_SECRET=

# System SMTP — used for magic-code login emails (set by super admin on VPS)
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_SMTP_FROM=T2GCRM
